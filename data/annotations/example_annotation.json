{
  "info": {
    "version": "2.0",
    "description": "Defect annotation schema for Siamese T-shirt defect inspection: each inspected image is paired with a reference image and a list of defect instances (class, bounding box, segmentation mask only)",
    "defect_classes": [
      "print_crack", "spot_stain", "ghosting", "print_missing",
      "print_misalignment", "color_deviation", "fabric_damage", "other_anomaly"
    ]
  },

  "images": [
    {
      "image_id": "tshirt_001_defect_001",
      "file_name": "images/tshirt_001_defect_001.png",
      "reference_image": "reference/ST001_BLACK_L_v1.png",
      "width": 2048,
      "height": 2048,
      "defects": [
        {
          "category": "print_crack",
          "bbox": [640, 300, 180, 90],
          "segmentation": {
            "format": "polygon",
            "points": [[640, 300], [820, 300], [820, 390], [640, 390]]
          }
        },
        {
          "category": "spot_stain",
          "bbox": [1200, 900, 60, 55],
          "segmentation": {
            "format": "rle",
            "size": [2048, 2048],
            "counts": "PLACEHOLDER_RLE_STRING"
          }
        }
      ]
    },
    {
      "image_id": "tshirt_001_good_001",
      "file_name": "images/tshirt_001_good_001.png",
      "reference_image": "reference/ST001_BLACK_L_v1.png",
      "width": 2048,
      "height": 2048,
      "defects": []
    }
  ]
}
